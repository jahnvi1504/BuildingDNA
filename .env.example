# Copy to .env for local development. Never commit real credentials.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Unpacked EnergyPlus 26.1.0 directory.
ENERGYPLUS_HOME=.local/EnergyPlus-26.1.0/EnergyPlus-26.1.0-6f2e40d102-Windows-x86_64

# Simulation inputs populated during environment setup.
ECOLOOP_IDF=models/baseline/small_office.idf
ECOLOOP_EPW=models/weather/bengaluru.epw

# The reason layer is optional; Tier 1 always remains operational.
ECOLOOP_REASON_ENABLED=true
ECOLOOP_REASON_INTERVAL_MINUTES=60
