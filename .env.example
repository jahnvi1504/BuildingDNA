# Local OpenAI-compatible model server. The Ollama key is a required placeholder,
# not a secret and is never sent outside this machine.
ECOLOOP_LLM_BASE_URL=http://localhost:11434/v1
ECOLOOP_LLM_API_KEY=ollama
ECOLOOP_LLM_MODEL=llama3.1:8b
# Bound local inference so deterministic Tier 1 can continue after an Ollama stall.
ECOLOOP_LLM_TIMEOUT_SECONDS=120

# Unpacked EnergyPlus 26.1.0 directory.
ENERGYPLUS_HOME=.local/EnergyPlus-26.1.0/EnergyPlus-26.1.0-6f2e40d102-Windows-x86_64

# Simulation inputs populated during environment setup.
ECOLOOP_IDF=models/baseline/small_office.idf
ECOLOOP_EPW=models/weather/bengaluru.epw

# The reason layer is optional; Tier 1 always remains operational.
ECOLOOP_REASON_ENABLED=true
# Validated matched evaluation cadence: 56 checkpoints across 672 simulated hours.
ECOLOOP_REASON_INTERVAL_MINUTES=720
# off keeps the original single-agent flow; compact uses one JSON-only debate
# request; full makes three sequential role-specific requests.
AI_DEBATE_MODE=compact
# Default evaluation scope: four inclusive seasonal weeks (4 x 168 = 672 hours).
# Set ECOLOOP_FULL_YEAR=true to run the original continuous calendar year.
ECOLOOP_FULL_YEAR=false
ECOLOOP_REPRESENTATIVE_PERIODS=["01-15:01-21","04-15:04-21","07-15:07-21","10-15:10-21"]
